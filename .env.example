# Copy to .env (project root or backend/) — never commit real keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional — Google Calendar → Google Meet (personal OAuth client, not internship GCP).
# Without these, Meeting Intelligence uses free Jitsi rooms for Join Meet demos.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/meeting-intel/google/callback
